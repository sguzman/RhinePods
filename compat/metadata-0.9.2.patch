+// Publish episode-specific metadata to the browser, which can forward it to
+// the OS media controls (e.g., Firefox MPRIS on Linux). Do not override browser
+// media-key handling or the native HTML audio/video element.
+#[wasm_bindgen(inline_js = r#"
+export function rhinepodsSetMediaMetadata(title, artist, album, artworkUrl) {
+    if (typeof navigator === "undefined" || !("mediaSession" in navigator) ||
+        typeof window === "undefined" || typeof window.MediaMetadata !== "function") return;
+    const artwork = [];
+    if (artworkUrl) {
+        try {
+            const image = new URL(artworkUrl, document.baseURI);
+            if (["https:", "http:", "blob:"].includes(image.protocol)) {
+                artwork.push({src: image.href});
+            }
+        } catch (_) { /* Keep the text metadata even if artwork is invalid. */ }
+    }
+    try {
+        navigator.mediaSession.metadata = new window.MediaMetadata({
+            title, artist, album, artwork
+        });
+    } catch (_) { /* The browser may not implement MediaMetadata. */ }
+}
+export function rhinepodsClearMediaMetadata() {
+    if (typeof navigator !== "undefined" && "mediaSession" in navigator) {
+        try { navigator.mediaSession.metadata = null; } catch (_) {}
+    }
+}
+"#)]
