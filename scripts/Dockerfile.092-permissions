# Fix the exact failure confirmed on eosbox: web/index.html was root:root
# mode 0600 in the compiled artifact. Nginx workers run as 'nginx' and received 403.
# Inherit the EXISTING already-built local image; no remote pull or Rust build.
FROM local/rhinepods:pinepods-0.9.2-metadata-43643575697
LABEL org.opencontainers.image.description="RhinePods 0.9.2 Media Session: Nginx-readable frontend permission repair"
RUN chmod -R a+rX /var/www/html
